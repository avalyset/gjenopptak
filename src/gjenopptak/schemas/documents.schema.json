{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gjenopptak.local/schemas/documents-1.json",
  "title": "document",
  "description": "Ett verk i utvalgsrammen. Rådata ligger i data/raw/, aldri i git. Se ADR-0001.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "doc_id", "openalex_id", "field_key", "publication_year",
    "has_fulltext", "harvested_at"
  ],
  "properties": {
    "schema_version": {"const": "documents-1"},
    "doc_id": {"type": "string", "minLength": 1,
               "description": "Stabil intern nøkkel. Lik openalex_id uten URL-prefiks."},
    "openalex_id": {"type": "string", "pattern": "^https://openalex\\.org/W[0-9]+$"},
    "doi": {"type": ["string", "null"]},
    "title": {"type": ["string", "null"]},
    "field_key": {"enum": ["tekstvitenskap", "klinisk_epidemiologi", "arkeologi", "energimodellering"],
                  "description": "Ett av de fire feltene i PREREG-v1 §4."},
    "openalex_topic_ids": {"type": "array", "items": {"type": "string"},
                           "description": "Oppløste emne-ID-er. Føres i ADDENDUM-01."},
    "publication_year": {"type": "integer", "minimum": 1500, "maximum": 2100},
    "has_fulltext": {"type": "boolean"},
    "language": {"type": ["string", "null"]},
    "is_oa": {"type": ["boolean", "null"]},
    "license": {"type": ["string", "null"],
                "description": "Lisens slik kilden oppgir den. Styrer om fulltekst kan lagres, ADR-0001."},
    "fulltext_source": {"type": ["string", "null"],
                        "description": "pmc | europepmc | publisher | null"},
    "fulltext_format": {"enum": ["jats", "tei", "pdf", "none", null]},
    "raw_path": {"type": ["string", "null"],
                 "description": "Sti under data/raw/. Committes aldri."},
    "raw_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "raw_bytes": {"type": ["integer", "null"], "minimum": 0},
    "source_url": {"type": ["string", "null"]},
    "harvested_at": {"type": "string", "format": "date-time"},
    "excluded": {"type": "boolean", "default": false},
    "excluded_reason": {"type": ["string", "null"],
                        "description": "Utelatte telles med grunn og erstattes ikke, ADR-0001."},
    "sample_seed": {"type": ["string", "null"],
                    "description": "Frø brukt ved trekking. Se PREREG-v1 §4 og ADDENDUM-01."},
    "is_control": {"type": "boolean", "default": false},
    "control_kind": {"enum": ["positive", "negative", null],
                     "description": "PREREG-v1 §7."}
  }
}
