{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/avalyset/gjenopptak/schemas/kandidat.schema.json",
  "title": "Kandidatrad — registerformat claims-2 med usikkerheten på raden",
  "description": "Én rad = ett bekreftet treff. Byggeplanen B3: hver rad bærer sin egen usikkerhet, så tallet kan ikke leses uten forbeholdene som gjelder akkurat den raden. Feltene fra claims-2 er uendret; sil, leser, verksniva og cites_coverage er lagt til.",
  "type": "object",
  "required": [
    "schema_version",
    "claim_id",
    "candidate_id",
    "doc_id",
    "field_key",
    "obstacle_class",
    "tvil",
    "loftbarhet",
    "falsified",
    "cites_coverage",
    "tested_at",
    "section_raw",
    "section_label_provenance",
    "unit",
    "passage_span",
    "sil",
    "leser"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "claims-2"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^CLAIM-"
    },
    "candidate_id": {
      "type": "string",
      "description": "løpenummer i kjøringen, ikke en PS-id"
    },
    "doc_id": {
      "type": "string",
      "description": "OpenAlex work id"
    },
    "field_key": {
      "type": "string"
    },
    "obstacle_class": {
      "type": "string",
      "description": "H1–H9 fra PREREG-v1 §5, eller <klasse>/H7-uavklart fra ADDENDUM-05. Avledes av en tabell, aldri av en modell (ADR-0004).",
      "pattern": "^(H[1-9]|H[1-9]/H7-uavklart)$"
    },
    "tvil": {
      "type": "boolean",
      "description": "Leserens eget tvilsflagg. Det er den enkeltopplysningen som forutsier presisjon best: blind presisjon 97,6 % der tvil er false, 75,9 % der den er true (ADDENDUM-23 §7.2)."
    },
    "unit": {
      "enum": [
        "sentence",
        "passage"
      ],
      "description": "sentence når det ugjorte og hindringen står i SAMME setning (M1-streng), passage når de er spredt over ±2 (M1-passasje). ADDENDUM-03 §1.2. Avledet av dommerens oppfølgingskall."
    },
    "passage_span": {
      "type": "object",
      "required": [
        "start_index",
        "end_index",
        "n_sentences",
        "window"
      ],
      "properties": {
        "start_index": {
          "type": "integer"
        },
        "end_index": {
          "type": "integer"
        },
        "n_sentences": {
          "type": "integer"
        },
        "window": {
          "type": "integer",
          "const": 2
        }
      }
    },
    "section_raw": {
      "type": "string"
    },
    "section_label_provenance": {
      "enum": [
        "source",
        "parser"
      ],
      "description": "source = kildens egen merking, parser = parserens gjetning (ADR-0007). En seksjonsetikett fra parseren er en hypotese, ikke en opplysning."
    },
    "sil": {
      "type": "object",
      "description": "Hvilket silledd fanget raden, og hva presisjonen er MÅLT til for det leddet. Per klasse er presisjonen ikke målt; per kilde er den.",
      "required": [
        "kilde",
        "presisjon",
        "presisjon_ki",
        "ikke_prosa"
      ],
      "properties": {
        "kilde": {
          "enum": [
            "dommer",
            "ekstraksjon",
            "begge"
          ]
        },
        "presisjon": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "presisjon_ki": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Wilson 95 %. begge 34,5 [29,8–39,6], dommer 14,3 [12,8–16,0], ekstraksjon 7,2 [5,4–9,4] (ADDENDUM-22 §10)"
        },
        "presisjon_kilde": {
          "type": "string"
        },
        "ikke_prosa": {
          "type": "boolean",
          "description": "G3-regelen, versjonert i ikkeprosa.py. MERKET, aldri fjernet: 18,1 % av dømt materiale er ikke prosa, men bare 2,5 % av treffene."
        },
        "ikke_prosa_regel_sha256": {
          "type": "string"
        }
      }
    },
    "leser": {
      "type": "object",
      "description": "Hvem som avgjorde raden, og hva presisjonen er målt til for nettopp dens tvilsverdi.",
      "required": [
        "modell",
        "regelfil_sha256",
        "presisjon_ved_tvil"
      ],
      "properties": {
        "modell": {
          "type": "string",
          "description": "agentisk Opus; ett-kall-modeller er sil-klasse (ADR-0012)"
        },
        "regelfil_sha256": {
          "type": "string"
        },
        "presisjon_ved_tvil": {
          "type": "number",
          "description": "0,976 når tvil er false, 0,759 når den er true (ADDENDUM-23 §7.2)"
        },
        "modus": {
          "enum": [
            "subagent",
            "cli"
          ]
        }
      }
    },
    "verksniva": {
      "type": [
        "object",
        "null"
      ],
      "description": "Materialtilgang for verket, og hva vurderingen IKKE ser.",
      "required": [
        "materialtilgang",
        "ser_ikke"
      ],
      "properties": {
        "materialtilgang": {
          "enum": [
            "ÅPEN",
            "DELVIS",
            "LUKKET"
          ]
        },
        "maskinlesbar": {
          "type": "boolean"
        },
        "eier": {
          "type": "string"
        },
        "tilgang": {
          "type": "string"
        },
        "forsok_mulig": {
          "type": "boolean"
        },
        "ser_ikke": {
          "type": "string",
          "description": "H8 utenfor verket: tilgangssituasjonen endrer seg utenfor materialet (ADR-0010). Heron gikk fra H1 til H8 uten at teksten endret seg."
        }
      }
    },
    "cites_coverage": {
      "type": "object",
      "description": "Falsifiseringens dekningsgrad for verket. Uten måling er den «ikke målt», ALDRI 0 — et umålt nulltall var ett av de ti grønn-og-feil-tilfellene.",
      "required": [
        "fulltext_available",
        "fulltext_total",
        "coverage_ratio",
        "status"
      ],
      "properties": {
        "fulltext_available": {
          "type": [
            "integer",
            "null"
          ]
        },
        "fulltext_total": {
          "type": [
            "integer",
            "null"
          ]
        },
        "coverage_ratio": {
          "type": [
            "number",
            "null"
          ]
        },
        "status": {
          "enum": [
            "målt",
            "ikke målt"
          ]
        },
        "kilde": {
          "type": "string"
        }
      }
    },
    "loftbarhet": {
      "type": "array",
      "minItems": 1,
      "description": "Datert vurdering (ADR-0010). Løftbarhet er ikke en egenskap ved teksten: Heron gikk fra H1 til H8 uten at teksten endret seg, så en vurdering uten dato er ubrukelig.",
      "items": {
        "type": "object",
        "required": [
          "vurdert_dato",
          "tabellversjon",
          "obstacle_class"
        ],
        "properties": {
          "vurdert_dato": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "datopresisjon": {
            "enum": [
              "dag",
              "måned",
              "år"
            ]
          },
          "tabellversjon": {
            "type": "string"
          },
          "obstacle_class": {
            "type": "string"
          },
          "loftbar": {
            "enum": [
              "ja",
              "nei",
              "uavklart",
              null
            ]
          }
        }
      }
    },
    "falsified": {
      "type": "boolean"
    },
    "survived": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "tested_at": {
      "type": "string"
    },
    "parser_version": {
      "type": "string"
    },
    "parser_model_version": {
      "type": "string"
    },
    "notes": {
      "type": "string",
      "description": "leserens begrunnelse, én setning"
    }
  }
}
