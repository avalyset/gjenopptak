{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gjenopptak.local/schemas/claims-2.json",
  "title": "claim",
  "description": "Kandidat merket «hindringen er opphevet, spørsmålet står åpent», etter falsifiseringstest mot siteringsgrafen. PREREG-v1 §8. ADR-0010: løftbarhet er datert — hver vurdering bærer dato og tabellversjon, og historikken er tilføyelsesbasert.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_id",
    "candidate_id",
    "doc_id",
    "field_key",
    "obstacle_class",
    "loftbarhet",
    "falsified",
    "cites_coverage",
    "tested_at",
    "section_raw",
    "section_label_provenance",
    "unit",
    "passage_span"
  ],
  "properties": {
    "schema_version": {
      "const": "claims-2"
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "doc_id": {
      "type": "string",
      "minLength": 1
    },
    "field_key": {
      "enum": [
        "tekstvitenskap",
        "klinisk_epidemiologi",
        "arkeologi",
        "energimodellering"
      ]
    },
    "section_raw": {
      "type": "string",
      "description": "Seksjonsetiketten setningen sto under, båret urørt fra sentences. ADR-0002."
    },
    "section_label_provenance": {
      "enum": [
        "source",
        "parser"
      ],
      "description": "Hvor seksjonsetiketten kommer fra. source = kilden merker seksjonen selv (JATS <sec sec-type>/<title> el.l.); parser = utledet av oss, typisk GROBID. Påkrevd, lukket sett, ingen standardverdi. ADR-0007."
    },
    "parser_version": {
      "type": [
        "string",
        "null"
      ],
      "description": "GROBID-versjon. Påkrevd og ikke-tom når provenance er parser. ADR-0007."
    },
    "parser_model_version": {
      "type": [
        "string",
        "null"
      ],
      "description": "Modellversjonen som ga seksjonsinndelingen. Påkrevd og ikke-tom når provenance er parser. ADR-0007."
    },
    "unit": {
      "enum": [
        "sentence",
        "passage"
      ],
      "description": "Hvor snevert treffkriteriet ble oppfylt: sentence = det ugjorte OG hindringen står i samme setning; passage = de står innenfor passasjen (±2 setninger) og er knyttet til hverandre. Observasjonsenheten er alltid passasjen; dette feltet bærer følsomheten. ADDENDUM-03 §1."
    },
    "passage_span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_index",
        "end_index",
        "n_sentences",
        "window"
      ],
      "description": "Passasjen treffet ble avgjort på, i setningsindekser fra sentences.jsonl. ADDENDUM-03 §1.",
      "properties": {
        "start_index": {
          "type": "integer",
          "minimum": 0
        },
        "end_index": {
          "type": "integer",
          "minimum": 0
        },
        "n_sentences": {
          "type": "integer",
          "minimum": 1
        },
        "window": {
          "type": "integer",
          "minimum": 0,
          "description": "±k setninger rundt treffsetningen. 2 etter ADDENDUM-03 §1."
        }
      }
    },
    "obstacle_class": {
      "enum": [
        "H1",
        "H2",
        "H3",
        "H4",
        "H5",
        "H6",
        "H7",
        "H8",
        "H9",
        "H5/H7-uavklart",
        "H3/H7-uavklart",
        "H2/H7-uavklart",
        "H1/H7-uavklart"
      ],
      "description": " Naboparene H1/H2/H3/H5 mot H7 kan ikke alltid skilles av passasjen: arbeidsmengde og manglende data ser like ut i formuleringen. Er den uavklart, kodes <klasse>/H7-uavklart. ADDENDUM-05."
    },
    "falsified": {
      "type": "boolean",
      "description": "true = noen har alt svart. Treff i siteringsgrafen ⇒ kandidaten er gal."
    },
    "falsified_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "OpenAlex-ID-er til siterende arbeid som svarer."
    },
    "cites_total": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "cites_checked": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "cites_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fulltext_available",
        "fulltext_total",
        "coverage_ratio"
      ],
      "description": "Dekningsgrad per felt rapporteres. Lav dekning svekker kandidaten, styrker den aldri. PREREG-v1 §8.",
      "properties": {
        "fulltext_available": {
          "type": "integer",
          "minimum": 0
        },
        "fulltext_total": {
          "type": "integer",
          "minimum": 0
        },
        "coverage_ratio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "survived": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Måltallet er hvor mange som overlever, ikke hvor mange som ble foreslått."
    },
    "tested_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "loftbarhet": {
      "type": "array",
      "minItems": 1,
      "description": "Daterte løftbarhetsvurderinger, eldste først. Nyeste gjelder; tidligere blir stående. Oppslaget er (klasse, tabellversjon, dato) — ADR-0010. En vurdering endres aldri, bare føyes til.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "vurdert_dato",
          "datopresisjon",
          "tabellversjon",
          "obstacle_class",
          "verdi",
          "vurdert_av"
        ],
        "properties": {
          "vurdert_dato": {
            "type": "string",
            "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$",
            "description": "ISO-dato, men aldri finere enn kilden tillater: ÅÅÅÅ, ÅÅÅÅ-MM eller ÅÅÅÅ-MM-DD. En oppdiktet dag er verre enn en grov dato (ADR-0010 tillegg)."
          },
          "tabellversjon": {
            "type": "string",
            "minLength": 1,
            "description": "Hvilken låst løftbarhetstabell oppslaget ble gjort mot."
          },
          "obstacle_class": {
            "enum": [
              "H1",
              "H2",
              "H3",
              "H4",
              "H5",
              "H6",
              "H7",
              "H8",
              "H9",
              "H5/H7-uavklart",
              "H3/H7-uavklart",
              "H2/H7-uavklart",
              "H1/H7-uavklart"
            ],
            "description": " Naboparene H1/H2/H3/H5 mot H7 kan ikke alltid skilles av passasjen: arbeidsmengde og manglende data ser like ut i formuleringen. Er den uavklart, kodes <klasse>/H7-uavklart. ADDENDUM-05."
          },
          "verdi": {
            "enum": [
              "ja",
              "ja_med_forbehold",
              "delvis",
              "nei",
              "usikker",
              "uavklart"
            ],
            "description": " Uavklarte naboklasser får «uavklart», aldri «ja»: PREREG §5 gir H1 «ja», og det anslaget er kjent for høyt. ADDENDUM-05."
          },
          "grunn": {
            "type": [
              "string",
              "null"
            ],
            "description": "Hvorfor klassen gjelder nå. Påkrevd i praksis når den skiller seg fra forrige vurdering."
          },
          "kilde": {
            "type": [
              "string",
              "null"
            ],
            "description": "Belegg for grunnen."
          },
          "vurdert_av": {
            "type": "string",
            "minLength": 1,
            "description": "Hvem vurderingen tilhører: «forfatterens egen formulering, klassifisert av oss» når klassen er lest ut av verkets egen tekst, «oss» når vi har vurdert mot kilde."
          },
          "datopresisjon": {
            "enum": [
              "dag",
              "måned",
              "år"
            ],
            "description": "Hvor fin datoen faktisk er. Må stemme med formen på vurdert_dato."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "datopresisjon": {
                  "const": "år"
                }
              },
              "required": [
                "datopresisjon"
              ]
            },
            "then": {
              "properties": {
                "vurdert_dato": {
                  "pattern": "^\\d{4}$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "datopresisjon": {
                  "const": "måned"
                }
              },
              "required": [
                "datopresisjon"
              ]
            },
            "then": {
              "properties": {
                "vurdert_dato": {
                  "pattern": "^\\d{4}-\\d{2}$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "datopresisjon": {
                  "const": "dag"
                }
              },
              "required": [
                "datopresisjon"
              ]
            },
            "then": {
              "properties": {
                "vurdert_dato": {
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                }
              }
            }
          }
        ]
      }
    },
    "parkert": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "utloser",
        "parkert_dato"
      ],
      "description": "Kandidaten er verken forsøkt eller avvist: den venter på at noe skal endre seg (ADR-0010).",
      "properties": {
        "utloser": {
          "type": "string",
          "minLength": 1
        },
        "parkert_dato": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "begrunnelse": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "identifikatorer": {
      "type": [
        "array",
        "null"
      ],
      "description": "Eksterne identifikatorer for materialet det ugjorte gjelder — ikke for påstanden selv. Lagt til 2026-09-26 for Diktyon-numrene til Heron-håndskriftene. Valgfri, så eldre claims-2-poster validerer uendret.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordning",
          "verdi"
        ],
        "properties": {
          "ordning": {
            "type": "string",
            "minLength": 1,
            "description": "Navnet på identifikatorsystemet, f.eks. «Diktyon» eller «BL-signatur»."
          },
          "verdi": {
            "type": "string",
            "minLength": 1
          },
          "etikett": {
            "type": [
              "string",
              "null"
            ],
            "description": "Sigel eller kortnavn i arbeidet, f.eks. «Bd»."
          },
          "kilde": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "if": {
    "properties": {
      "section_label_provenance": {
        "const": "parser"
      }
    },
    "required": [
      "section_label_provenance"
    ]
  },
  "then": {
    "required": [
      "parser_version",
      "parser_model_version"
    ],
    "properties": {
      "parser_version": {
        "type": "string",
        "minLength": 1
      },
      "parser_model_version": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
